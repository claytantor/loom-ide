{
  "name": "loom-ide",
  "version": "0.1.0",
  "description": "An Ink-powered TUI IDE that sits beside Claude Code.",
  "type": "module",
  "license": "MIT",
  "repository": "github:claytantor/loom-ide",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "loom": "dist/cli.js"
  },
  "files": [
    "dist",
    "seeds",
    "install.sh",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node -e \"require('fs').chmodSync('dist/cli.js', 0o755)\"",
    "dev": "tsx src/cli.tsx",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.176",
    "chokidar": "^4.0.1",
    "ignore": "^7.0.0",
    "ink": "^5.2.1",
    "react": "^18.3.1",
    "yaml": "^2.6.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "ink-testing-library": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
